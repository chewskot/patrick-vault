<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>Admin - Správa Lega</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white p-8">
    <div class="max-w-4xl mx-auto">
        <div class="flex justify-between mb-8">
            <h1 class="text-2xl font-bold">Správa sbírky</h1>
            <a href="/" class="text-blue-400 hover:underline">← Zpět na přehled</a>
        </div>

        <div class="bg-gray-800 p-6 rounded-lg mb-8 shadow-xl border border-gray-700">
            <h2 class="text-xl mb-4 text-yellow-500 font-semibold">Přidat nový set</h2>
            <form action="/add" method="POST" class="flex gap-4">
                <input type="text" name="set_num" placeholder="Číslo setu (např. 75367)" required 
                       class="bg-gray-700 border border-gray-600 p-2 rounded flex-1 focus:outline-none focus:border-yellow-500 text-white">
                <input type="number" name="quantity" value="1" min="1" required 
                       class="bg-gray-700 border border-gray-600 p-2 rounded w-20 focus:outline-none">
                <button type="submit" class="bg-yellow-600 hover:bg-yellow-500 px-6 py-2 rounded font-bold transition">Přidat do DB</button>
            </form>
        </div>

        <div class="bg-gray-800 rounded-lg overflow-hidden border border-gray-700">
            <table class="w-full text-left">
                <thead class="bg-gray-700 text-gray-300">
                    <tr>
                        <th class="p-4">Set</th>
                        <th class="p-4 text-center">Ks</th>
                        <th class="p-4 text-right">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    <% sets.forEach(set => { %>
                    <tr class="border-b border-gray-700 hover:bg-gray-750">
                        <td class="p-4 font-mono"><%= set.set_num %> - <%= set.name %></td>
                        <td class="p-4 text-center"><%= set.quantity %></td>
                        <td class="p-4 text-right">
                            <form action="/delete/<%= set.id %>" method="POST" onsubmit="return confirm('Opravdu smazat?')">
                                <button class="text-red-500 hover:text-red-400 font-bold">Smazat</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>