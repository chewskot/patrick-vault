<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <title>LEGO Vault - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white p-8">
    <div class="max-w-5xl mx-auto">
        <header class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-black text-yellow-500">🧱 ADMIN PANEL</h1>
            <a href="/" class="text-gray-400 hover:text-white">← Galerie</a>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
            <section class="bg-gray-800 p-6 rounded-2xl border border-gray-700">
                <h2 class="text-lg font-bold mb-4 text-blue-400">Hromadný import (Formát: 1x 75388)</h2>
                <form action="/bulk-import" method="POST">
                    <textarea name="importData" rows="8" class="w-full bg-gray-900 border border-gray-700 p-3 rounded mb-4 text-sm font-mono text-gray-300" placeholder="1x 75388&#10;15x 75373"></textarea>
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 py-2 rounded font-bold transition">Spustit import</button>
                </form>
            </section>

            <section class="bg-red-900/20 p-6 rounded-2xl border border-red-900/50">
                <h2 class="text-lg font-bold mb-4 text-red-500">Nebezpečná zóna</h2>
                <form action="/clear-inventory" method="POST" onsubmit="return confirm('OPRAVDU SMAZAT VŠE?')">
                    <p class="text-xs text-gray-400 mb-4 italic">Zadej heslo pro smazání celé databáze:</p>
                    <input type="password" name="confirmPassword" placeholder="Tvoje heslo" required class="w-full bg-gray-900 border border-red-900/50 p-2 rounded mb-4">
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-500 py-2 rounded font-bold transition italic">Smazat všechna data</button>
                </form>
            </section>
        </div>

        <div class="bg-gray-800 rounded-2xl overflow-hidden border border-gray-700">
            <table class="w-full text-left">
                <tbody class="divide-y divide-gray-700">
                    <% sets.forEach(set => { %>
                    <tr class="hover:bg-gray-750">
                        <td class="p-4 flex items-center gap-4">
                            <img src="<%= set.img_url %>" class="w-10 h-10 object-contain bg-white rounded">
                            <span class="text-sm font-bold"><%= set.name %> (<%= set.set_num %>)</span>
                        </td>
                        <td class="p-4">
                            <form action="/update-quantity/<%= set.id %>" method="POST" class="flex gap-2">
                                <input type="number" name="quantity" value="<%= set.quantity %>" class="w-14 bg-gray-900 border border-gray-700 rounded text-center text-sm">
                                <button type="submit" class="text-blue-500 text-xs font-bold">OK</button>
                            </form>
                        </td>
                        <td class="p-4 text-right">
                            <form action="/delete/<%= set.id %>" method="POST"><button class="text-red-500 text-xs">Smazat</button></form>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>