<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LEGO Vault - Moje Sbírka</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white font-sans">
    <div class="container mx-auto p-4 md:p-8">
        <header class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4 border-b border-gray-800 pb-6">
            <div>
                <h1 class="text-4xl font-black text-yellow-500 tracking-tighter">🧱 LEGO VAULT</h1>
                <p class="text-gray-400 font-medium">Dokumentace neotevřených krabic</p>
            </div>
            <a href="/admin" class="bg-gray-800 hover:bg-gray-700 text-gray-400 px-4 py-2 rounded-lg text-sm transition">Správa sbírky</a>
        </header>

        <form action="/" method="GET" class="bg-gray-800 p-4 rounded-2xl mb-10 shadow-xl border border-gray-700">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div class="md:col-span-2">
                    <label class="block text-xs font-bold text-gray-500 mb-1 uppercase">Hledat</label>
                    <input type="text" name="search" placeholder="Číslo nebo název..." value="<%= search %>" 
                           class="w-full bg-gray-900 border border-gray-600 p-3 rounded-xl focus:ring-2 focus:ring-yellow-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1 uppercase">Rok</label>
                    <select name="year" class="w-full bg-gray-900 border border-gray-600 p-3 rounded-xl outline-none">
                        <option value="">Všechny</option>
                        <% years.forEach(y => { %>
                            <option value="<%= y.year %>" <%= currentYear == y.year ? 'selected' : '' %>><%= y.year %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 mb-1 uppercase">Téma</label>
                    <select name="theme" class="w-full bg-gray-900 border border-gray-600 p-3 rounded-xl outline-none">
                        <option value="">Všechna</option>
                        <% themes.forEach(t => { %>
                            <option value="<%= t.theme %>" <%= currentTheme == t.theme ? 'selected' : '' %>><%= t.theme %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
            <div class="mt-4 flex gap-2">
                <button type="submit" class="flex-1 bg-yellow-500 hover:bg-yellow-400 text-black font-bold py-3 rounded-xl transition shadow-lg">Aplikovat filtry</button>
                <a href="/" class="bg-gray-700 hover:bg-gray-600 px-6 py-3 rounded-xl transition">Zrušit</a>
            </div>
        </form>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-6">
            <% sets.forEach(set => { %>
                <div class="group bg-gray-800 rounded-3xl overflow-hidden border border-gray-700 hover:border-yellow-500 transition-all duration-300 shadow-lg hover:shadow-yellow-500/10">
                    <div class="relative bg-white p-6">
                        <img src="<%= set.img_url %>" alt="<%= set.name %>" class="w-full h-40 object-contain group-hover:scale-110 transition-transform duration-300">
                        <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full border border-white/20">
                            MISB
                        </div>
                        <div class="absolute -bottom-4 right-4 bg-yellow-500 text-black font-black w-10 h-10 flex items-center justify-center rounded-xl shadow-lg ring-4 ring-gray-800">
                            <%= set.quantity %>
                        </div>
                    </div>
                    <div class="p-5 pt-7">
                        <div class="text-yellow-500 font-mono text-xs font-bold mb-1"><%= set.set_num %></div>
                        <h3 class="font-bold text-gray-100 leading-tight h-12 overflow-hidden mb-3"><%= set.name %></h3>
                        <div class="flex justify-between items-center text-xs border-t border-gray-700 pt-3">
                            <span class="text-gray-400 bg-gray-900 px-2 py-1 rounded"><%= set.theme %></span>
                            <span class="text-gray-500 font-bold"><%= set.year %></span>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>

        <% if (sets.length === 0) { %>
            <div class="text-center py-20 bg-gray-800/50 rounded-3xl border border-dashed border-gray-700">
                <p class="text-gray-500 text-xl font-medium">Žádný takový kousek ve sbírce nemám... zatím. 🙄</p>
            </div>
        <% } %>
    </div>
</body>
</html>